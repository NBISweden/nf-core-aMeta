/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // SUBWORKFLOW: QC
    withName: 'FASTQC' { // Applies to both raw and after trimming
        ext.args = '--quiet --nogroup'
    }
    withName: 'FASTQC_RAW' {
        publishDir = [
            path: { "$params.outdir/FASTQC_BEFORE_TRIMMING" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'FASTQC_TRIM' {
        ext.prefix = { "${meta.id}_trimmed" }
        publishDir = [
            path: { "$params.outdir/FASTQC_AFTER_TRIMMING" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'CUTADAPT' {
        cpus       = 1 // Snakemake original runs cutadapt single-threaded; module's --cores would otherwise use the process_medium default of 6
        memory     = { 4.GB * task.attempt }
        ext.args   = { [
            "--minimum-length 31",
            params.adapters_illumina ? "-a ${params.adapters_illumina}" : "",
            params.adapters_nextera  ? "-a ${params.adapters_nextera}"  : "",
            params.adapters_custom   ? params.adapters_custom.split(',').collect{ "-a ${it.trim()}" }.join(" ") : "",
        ].minus("").join(" ") }
        publishDir = [
            path: { "$params.outdir/CUTADAPT_ADAPTER_TRIMMING" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // SUBWORKFLOW: ALIGN
    // BOWTIE2 files
    withName: '.*:FASTQ_ALIGN_BOWTIE2:BAM_SORT_STATS_SAMTOOLS:SAMTOOLS_(SORT|INDEX)' {
        publishDir = [
            path: { "$params.outdir/BOWTIE2/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'SAMTOOLS_SORT' {
        ext.prefix = { "${meta.id}.sorted.AlignedToBowtie2DB"}
    }
    withName: 'BOWTIE2_.*' {
        publishDir = [ enabled: false ]
    }
    withName: 'BOWTIE2_BUILD' {
        cpus     = 4 // Snakemake original builds single-threaded; module's --threads would otherwise use the process_high default of 12
        ext.args = '--large-index'
    }
    withName: '.*:FASTQ_ALIGN_BOWTIE2:BOWTIE2_ALIGN' {
        ext.args  = '--end-to-end --very-sensitive'
        ext.args2 = '-q 1'
    }
    withName: '.*:FASTQ_ALIGN_BOWTIE2:BAM_SORT_STATS_SAMTOOLS:BAM_STATS_SAMTOOLS:.*' {
        publishDir = [ enabled: false ]
    }

    // SUBWORKFLOW: KRAKENUNIQ
    withName: 'KRAKENUNIQ_BUILD' {
        ext.args = '--kmer-len 21 --minimizer-len 11 --jellyfish-bin $( which jellyfish )'
        publishDir = [ enabled: false ]
    }
    withName: "KRONA_KTUPDATETAXONOMY" {
        storeDir = "$params.db_cache/ncbi_taxonomy"
        publishDir = [ enabled: false ]
    }
    withName: 'KRAKENUNIQ_PRELOADEDKRAKENUNIQ' {
        cpus       = 10 // Matches Snakemake original's KrakenUniq rule thread count
        memory     = { 200.GB * task.attempt } // --preload loads the full database into RAM; real aDNA databases routinely exceed 72GB
        ext.args2  = '--gzip-compressed --only-classified-out'
        publishDir = [
            path: { "$params.outdir/KRAKENUNIQ/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'KRAKENUNIQ_FILTER' {
        publishDir = [
            path: { "$params.outdir/KRAKENUNIQ/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'KRAKENUNIQ_TOKRONA' {
        publishDir = [
            path: { "$params.outdir/KRAKENUNIQ/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'KRONA_KTIMPORTTAXONOMY' {
        ext.prefix = { "${meta.id}.taxonomy.krona" }
        publishDir = [
            path: { "$params.outdir/KRAKENUNIQ/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'KRAKENUNIQ_ABUNDANCEMATRIX' {
        publishDir = [
            path: { "$params.outdir/KRAKENUNIQ_ABUNDANCE_MATRIX" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }


    // SUBWORKFLOW: Map Damage
    withName: 'WRITESEQIDS' {
        publishDir = [
            path: { "$params.outdir/MAPDAMAGE/${meta.id}/${meta.taxid}" },
            mode: params.publish_dir_mode
        ]
    }
    withName: 'SAMTOOLS_VIEW' {
        ext.prefix = { "${meta.id}.${meta.taxid}" }
        ext.args   = '-bh'
        ext.args2  = { meta.seqids.join(' ') }
        publishDir = [
            path: { "$params.outdir/MAPDAMAGE/${meta.id}/${meta.taxid}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MAPDAMAGE2' {
        memory    = { 8.GB * task.attempt }
        time      = { 20.h * task.attempt } // MCMC fitting runs per-sample-per-taxon; large BAMs exceed the process_single default of 4h
        ext.args  = '--merge-reference-sequences'
        publishDir = [
            path: { "$params.outdir/MAPDAMAGE/${meta.id}/${meta.taxid}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // SUBWORKFLOW: Malt
    withName: 'MALT_PREPAREDB' {
        publishDir = [
            path: { "$params.outdir/MALT_DB" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'MALT_BUILD' {
        cpus     = 20 // Matches Snakemake original's Build_Malt_DB rule thread count
        memory   = { 200.GB * task.attempt } // Indexing loads the full reference FASTA into RAM; real aDNA databases routinely exceed 72GB
        ext.args = '-s DNA'
        publishDir = [
            path: { "$params.outdir/MALT_DB" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MALT_RUN' {
        cpus   = 20 // Matches Snakemake original's Malt rule thread count
        memory = { 512.GB * task.attempt } // Matches the pipeline authors' own documented production requirement (aMeta/profile/config.yaml set-resources: Malt:mem_mb=512000)
        time   = { 80.h   * task.attempt } // Matches aMeta/profile/config.yaml set-resources: Malt:runtime=4800 (minutes)
        ext.args = { [
            '--mode BlastN', // Required!
            '--alignmentType SemiGlobal',
            '--minSupport 1',
            '--maxAlignmentsPerQuery 100',
            '--topPercent 1',
            '--minPercentIdentityLCA 85.0',
            '--minPercentIdentity 85.0',
            "--alignments ${meta.id}.trimmed.sam"
        ].join(" ").trim() }
        publishDir = [
            path: { "$params.outdir/MALT" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'MALT_QUANTIFYABUNDANCE' {
        publishDir = [
            path: { "$params.outdir/MALT_QUANTIFY_ABUNDANCE/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'MALT_ABUNDANCEMATRIXSAM' {
        publishDir = [
            path: { "$params.outdir/MALT_ABUNDANCE_MATRIX_SAM" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'MALT_ABUNDANCEMATRIXRMA6' {
        ext.args = "-r 'S'"
        publishDir = [
            path: { "$params.outdir/MALT_ABUNDANCE_MATRIX_RMA6" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // SUBWORKFLOW: authentic
    withName: 'MAKENODELIST' {
        publishDir = [
            path: params.outdir,
            mode: params.publish_dir_mode,
            saveAs: { filename ->
                filename.equals('versions.yml') ? null :
                    "AUTHENTICATION/${meta.id}/${filename - '.node_list.txt'}/node_list.txt"
            }
        ]
    }
    withName: 'MALTEXTRACT' {
        tag        = { meta.id }
        cpus       = 4
        memory     = { 32.GB * task.attempt } // Matches Snakemake original's hardcoded -Xmx32G default; override via a custom config with -c if needed
        ext.args   = [
                "--filter def_anc",
                "--reads",
                "--matches",
                "--minPI 85.0",
                "--maxReadLength 0",
                "--minComp 0.0",
                "--meganSummary",
                "--verbose",
                "--destackingOff",
                "--downSampOff",
                "--dupRemOff"
            ].join(" ")
        ext.prefix = "MaltExtract_output"
        publishDir = [
            path: { "$params.outdir/AUTHENTICATION/${meta.id}/${meta.taxid}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'POSTPROCESSINGAMPS' {
        stageInMode = 'copy' // files are written out to the malt extract folder breaking reentrancy
        publishDir = [
            path: { "$params.outdir/AUTHENTICATION/${meta.id}/${meta.taxid}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'BREADTHOFCOVERAGE' {
        publishDir = [
            path: { "$params.outdir/AUTHENTICATION/${meta.id}/${meta.taxid}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'READLENGTHDISTRIBUTION' {
        publishDir = [
            path: { "$params.outdir/AUTHENTICATION/${meta.id}/${meta.taxid}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'PMDTOOLS_SCORE'{
        publishDir = [
            path: { "$params.outdir/AUTHENTICATION/${meta.id}/${meta.taxid}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'PMDTOOLS_DEAMINATION' {
        publishDir = [
            path: { "$params.outdir/AUTHENTICATION/${meta.id}/${meta.taxid}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'AUTHENTICATIONPLOTS' {
        publishDir = [
            [
                path: { "$params.outdir/AUTHENTICATION/${meta.id}/${meta.taxid}" },
                mode: params.publish_dir_mode,
                saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
            ],
            [
                path: { "$params.outdir/AUTHENTICATION_PLOTS_PDF" },
                mode: params.publish_dir_mode,
                pattern: "*.pdf"
            ],
            [
                path: { "$params.outdir/AUTHENTICATION_PLOTS_PNG" },
                mode: params.publish_dir_mode,
                pattern: "*.png"
            ]
        ]
    }
    withName: 'AUTHENTICATIONSCORE' {
        ext.prefix = { "${meta.id}.${meta.taxid}" }
        publishDir = [
            path: { "$params.outdir/AUTHENTICATION/${meta.id}/${meta.taxid}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }
    withName: 'SAMTOOLS_FAIDX' {
        publishDir = [ enabled: false ]
    }

    // SUBWORKFLOW: summary
    withName: 'PLOTAUTHENTICATIONSCORE' {
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/MULTIQC" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
